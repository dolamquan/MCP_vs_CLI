{
  "name": "cli-vs-mcp-backend",
  "version": "1.0.0",
  "description": "Backend for CLI vs MCP token usage comparison app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test:phase2": "ts-node --transpile-only tests/test_phase_2/test_phase_2.ts",
    "test:phase3": "ts-node --transpile-only tests/test_phase_3/test_phase_3.ts",
    "test:phase4": "ts-node --transpile-only tests/test_phase_4/test_phase_4.ts",
    "test:phase5": "ts-node --transpile-only tests/test_phase_5/test_phase_5.ts",
    "test:phase6": "ts-node --transpile-only tests/test_phase_6/test_phase_6.ts",
    "test:phase7": "ts-node --transpile-only tests/test_phase_7/test_phase_7.ts",
    "test:phase8": "ts-node --transpile-only tests/test_phase_8/test_phase_8.ts",
    "test:test_all": "ts-node --transpile-only tests/run-all-tests.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.39",
    "prisma": "^7.8.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.2"
  }
}
