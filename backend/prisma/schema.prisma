// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Comparison {
  id String @id @default(cuid())

  cliCommand String
  mcpCommand String

  cliTokens       Int
  mcpTokens       Int
  tokenDifference Int

  cliInputCost  Float
  cliOutputCost Float
  cliTotalCost  Float

  mcpInputCost  Float
  mcpOutputCost Float
  mcpTotalCost  Float

  costDifference  Float
  amountSaved     Float
  percentageSaved Float

  recommendedOption    String
  recommendationReason String

  modelId   String
  modelName String

  createdAt DateTime @default(now())
}

model PricingModel {
  id String @id @default(cuid())

  modelId   String @unique
  modelName String
  provider  String

  inputCostPer1MTokens  Float
  outputCostPer1MTokens Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
