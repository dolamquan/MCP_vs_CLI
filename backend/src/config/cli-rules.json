{
  "allowedCommands": [
    "node",
    "npm",
    "npx",
    "git",
    "tsc",
    "tsx",
    "echo",
    "pwd",
    "ls",
    "dir",
    "type",
    "findstr"
  ],
  "blockedCommands": [
    "rm",
    "rmdir",
    "del",
    "erase",
    "format",
    "shutdown",
    "reboot",
    "sudo",
    "su",
    "chmod",
    "chown",
    "curl",
    "wget",
    "scp",
    "ssh",
    "powershell",
    "Invoke-WebRequest"
  ],
  "blockedPatterns": [
    "rm -rf",
    "del /s",
    "format ",
    "shutdown",
    "reboot",
    "sudo ",
    "&&",
    "||",
    ";",
    "|",
    ">",
    ">>",
    "<",
    "`",
    "$(",
    "%COMSPEC%"
  ],
  "maxCommandLength": 300,
  "executionTimeoutMs": 10000
}